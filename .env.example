APP_ENV=local
APP_VERSION=development
APP_URL=http://localhost:8080
HTTP_PORT=8080
APP_KEY=
SESSION_SECURE=false
DB_FORWARD_PORT=3306
DB_DATABASE=yinghua
DB_USERNAME=spl
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Local development mail catcher; SMTP credentials are optional locally.
MAILPIT_HTTP_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=映畫竹塹

# Phase 2 policies; secrets belong only in the ignored .env.
AUTH_SESSION_SECONDS=43200
AUTH_IDLE_SECONDS=1800
CSRF_SECONDS=3600
CAPTCHA_SECONDS=300
CAPTCHA_ATTEMPTS=3
PASSWORD_RESET_SECONDS=1800
TERMS_VERSION=2026-11-02
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Phase 3: server-only Places API (New) key; requires enabled API and billing.
GOOGLE_PLACES_API_KEY=
