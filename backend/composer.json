{
    "name": "spl/yinghua",
    "description": "API-only backend for Yinghua",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ezyang/htmlpurifier": "^4.19",
        "phpmailer/phpmailer": "~7.1.1"
    },
    "autoload": {"psr-4": {"Yinghua\\": "src/"}},
    "autoload-dev": {"psr-4": {"Yinghua\\Tests\\": "tests/"}},
    "config": {"allow-plugins": false, "sort-packages": true}
}
