includes:
    - /var/www/tools/vendor/phpat/phpat/extension.neon
parameters:
    level: 10
    phpVersion: 80511
    paths:
        - src
        - public/index.php
        - bin/console.php
        - bin/readiness.php
        - bin/recovery.php
        - config/routes.php
        - config/favorite-routes.php
        - config/itinerary-routes.php
        - config/seo-routes.php
        - config/news-admin-routes.php
        - config/offer-admin-routes.php
        - config/recommended-routes.php
        - tests/ArchitectureTest.php
    tmpDir: .build/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    bootstrapFiles:
        - vendor/autoload.php
services:
    -
        class: Yinghua\Tests\ArchitectureTest
        tags:
            - phpat.test
