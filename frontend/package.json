{
  "name": "spl-yinghua-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"assets/**/*.{js,css}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"assets/**/*.{js,css}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
