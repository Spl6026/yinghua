APP_VERSION=p0-20261024
RELEASE_COMMIT=REPLACE_WITH_FULL_GIT_COMMIT
RELEASE_APP_IMAGE=yinghua-release-app:p0-20261024
RELEASE_WEB_IMAGE=yinghua-release-web:p0-20261024
