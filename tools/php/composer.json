{
    "name": "spl/development-tools",
    "description": "Standalone development tools and locked dependencies; no application source",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpat/phpat": "^0.12.5",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7"
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "scripts": {
        "audit:locked": "@composer audit --locked"
    }
}
